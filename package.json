{
  "devDependencies": {
    "@biomejs/biome": "2.3.8"
  },
  "name": "ormx",
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.8",
    "mysql2": "^3.24.5",
    "nanoid": "^3.3.19",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.28",
    "rollup": "^4.64.0",
    "vite": "^8.3.2"
  },
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "biome check --write",
