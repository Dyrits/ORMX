{
  "author": "",
  "dependencies": {
    "@ormx/filters": "^0.4.1"
  },
  "description": "Unified datasource abstraction for Drizzle, Prisma, TypeORM, MikroORM and Supabase with transaction support",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mikro-orm/core": "^7.2.3",
    "@mikro-orm/pglite": "^7.2.3",
    "@mikro-orm/sql": "^7.2.3",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.117.2",
    "drizzle-orm": "^0.45.3",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.0",
    "typeorm": "^1.1.1",
    "typeorm-pglite": "^0.3.4",
    "typescript": "^5.7.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/drizzle.js",
      "types": "./dist/drizzle.d.ts"
    },
    "./mikro-orm": {
      "import": "./dist/mikro-orm.js",
      "types": "./dist/mikro-orm.d.ts"
    },
    "./prisma": {
      "import": "./dist/prisma.js",
      "types": "./dist/prisma.d.ts"
    },
    "./supabase": {
      "import": "./dist/supabase.js",
      "types": "./dist/supabase.d.ts"
    },
    "./typeorm": {
      "import": "./dist/typeorm.js",
      "types": "./dist/typeorm.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ormx",
    "datasource",
    "repository",
    "drizzle",
    "prisma",
    "supabase",
    "typeorm",
    "mikro-orm",
    "database",
    "orm"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "@ormx/datasources",
  "peerDependencies": {
    "@mikro-orm/core": ">=7.0.0",
    "@mikro-orm/sql": ">=7.0.0",
    "@prisma/client": ">=6.2.0",
    "drizzle-orm": ">=0.30.0",
    "typeorm": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    },
    "@mikro-orm/sql": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/datasources",
    "type": "git",
    "url": "git+https://github.com/Dyrits/ORMX.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "prepublishOnly": "bun run build",
    "pretest": "bun run generate",
    "pretypecheck": "bun run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.4.1"
}
